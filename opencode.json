{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ollama": {
      "models": {
        "qwen3.8:27b": {
          "body": {
            "reasoning_effort": "none",
            "max_tokens": 4096
          },
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "compatibility": {
            "maxTokensField": "max_tokens"
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 6000
    },
    "buffer": 6000
  },
  "mcp": {
    "servers": {
      "memory": {
        "type": "remote",
        "url": "http://127.0.0.1:18082/mcp"
      },
      "ghidra": {
        "type": "remote",
        "url": "http://127.0.0.1:18081/mcp",
        "timeout": {
          "execution": 180000
        }
      }
    }
  }
}
